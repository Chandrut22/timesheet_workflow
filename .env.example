# Copy to .env and fill in. Never commit .env.

# ---- LLM (used by app/extraction/timesheet_extractor.py) ----
MODEL_NAME=gpt-oss:20b
MODEL_PROVIDER=openai
BASE_URL=https://ollama.com/v1
API_KEY=your-api-key

# ---- Mailbox (Gmail example) ----
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=timesheets@genworx.ai
# Gmail: a 16-character App Password (needs 2-Step Verification), not the normal password
IMAP_PASSWORD=abcdefghijklmnop
IMAP_FOLDER=INBOX

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Listener ----
# Comma-separated full addresses or @domains
SENDER_WHITELIST=@genworx.ai,payroll@abcstaffing.com
REQUIRE_SENDER_AUTH=true
IDLE_TIMEOUT=300
# First run: "new" = only mail arriving from now on; "backfill" = also the last BACKFILL_DAYS days
START_FROM=new
BACKFILL_DAYS=2

# ---- Worker ----
OUTPUT_DIR=output
MAX_ATTEMPTS=3
